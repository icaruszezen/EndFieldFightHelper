<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EndFieldFightHelper.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="700"
             x:Class="EndFieldFightHelper.Views.OverlaySettingsPage"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="40" Spacing="20">
            <TextBlock Text="叠加显示" FontSize="28" FontWeight="Bold" />

            <Border Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,20,0,0">
                <StackPanel Spacing="16">
                    <TextBlock Text="显示控制" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="在屏幕顶层叠加显示预设内容" Opacity="0.7" />

                    <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="启用叠加层" FontWeight="SemiBold" />
                            <TextBlock Text="开启后将显示在所有窗口上层" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding OverlayEnabled}"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="鼠标穿透" FontWeight="SemiBold" />
                            <TextBlock Text="开启后不拦截点击，适合游戏界面" Opacity="0.7" FontSize="12" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding OverlayClickThrough}"
                                      VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="位置与尺寸" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="调整叠加层在屏幕上的位置和大小" Opacity="0.7" />

                    <Grid ColumnDefinitions="Auto,*,Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="10"
                          Margin="0,8,0,0">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="0" Grid.Column="1"
                                       Value="{Binding OverlayX}"
                                       Minimum="-10000"
                                       Maximum="10000"
                                       Increment="10" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Y" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="0" Grid.Column="3"
                                       Value="{Binding OverlayY}"
                                       Minimum="-10000"
                                       Maximum="10000"
                                       Increment="10" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="宽度" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding OverlayWidth}"
                                       Minimum="50"
                                       Maximum="10000"
                                       Increment="10" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="高度" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Row="1" Grid.Column="3"
                                       Value="{Binding OverlayHeight}"
                                       Minimum="30"
                                       Maximum="10000"
                                       Increment="10" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="透明度" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="设置叠加层整体透明度" Opacity="0.7" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,8,0,0">
                        <Slider Grid.Column="0"
                                Minimum="0.1"
                                Maximum="1"
                                Value="{Binding OverlayOpacity}"
                                TickFrequency="0.05"
                                IsSnapToTickEnabled="True" />
                        <NumericUpDown Grid.Column="1"
                                       Width="90"
                                       Value="{Binding OverlayOpacity}"
                                       Minimum="0.1"
                                       Maximum="1"
                                       Increment="0.05" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="叠加层内容" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="设置叠加层显示的自定义文本内容" Opacity="0.7" />
                    <TextBox Text="{Binding OverlayText}"
                             Watermark="输入叠加层显示内容"
                             Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
