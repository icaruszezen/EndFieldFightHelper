<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EndFieldFightHelper.ViewModels"
             xmlns:models="clr-namespace:EndFieldFightHelper.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="EndFieldFightHelper.Views.YoloDetectionPage"
             x:DataType="vm:YoloDetectionViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- 模型控制栏 -->
        <Border Grid.Row="0"
                Background="{DynamicResource SukiCardBackground}"
                CornerRadius="8"
                Padding="16"
                Margin="20,20,20,5">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="加载模型"
                            Command="{Binding LoadModelCommand}"
                            CommandParameter="{Binding $parent[TopLevel].StorageProvider}" />
                    <Border Background="{DynamicResource SukiBackground}"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModelStatusText}"
                                   Opacity="0.8"
                                   FontSize="12" />
                    </Border>
                </StackPanel>
                <Border Grid.Column="1" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             IsVisible="{Binding IsModelLoaded}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#4CAF50" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="8" Height="8"
                             IsVisible="{Binding !IsModelLoaded}">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#9E9E9E" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="就绪"
                               IsVisible="{Binding IsModelLoaded}"
                               Opacity="0.7"
                               FontSize="12" />
                    <TextBlock Text="未就绪"
                               IsVisible="{Binding !IsModelLoaded}"
                               Opacity="0.5"
                               FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 图像来源控制栏 -->
        <Border Grid.Row="1"
                Background="{DynamicResource SukiCardBackground}"
                CornerRadius="8"
                Padding="16"
                Margin="20,5,20,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="10">
                    <TextBlock Text="选择窗口" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Windows}"
                              SelectedItem="{Binding SelectedWindow}"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="请选择要截图的窗口">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                    <Button Content="刷新" Command="{Binding RefreshWindowsCommand}" />
                    <Button Content="截图识别"
                            Command="{Binding CaptureAndDetectCommand}"
                            Classes="Accent"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Content="持续识别"
                            Command="{Binding StartContinuousDetectionCommand}"
                            IsVisible="{Binding !IsContinuousDetecting}"
                            IsEnabled="{Binding !IsBusy}" />
                    <Button Content="停止识别"
                            Command="{Binding StopContinuousDetectionCommand}"
                            IsVisible="{Binding IsContinuousDetecting}"
                            Classes="Accent" />
                    <Button Content="加载图片识别"
                            Command="{Binding LoadImageAndDetectCommand}"
                            CommandParameter="{Binding $parent[TopLevel].StorageProvider}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区域：预览 + 结果列表 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,300" Margin="20,0,20,10">

            <!-- 左侧：图片预览 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    ClipToBounds="True"
                    Margin="0,0,10,0">
                <Grid>
                    <TextBlock Text="图片预览区域"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.3"
                               FontSize="24"
                               IsVisible="{Binding !HasImage}" />

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsDetecting}"
                                Spacing="10">
                        <ProgressBar IsIndeterminate="True"
                                     Width="200" />
                        <TextBlock Text="正在识别..."
                                   HorizontalAlignment="Center"
                                   Opacity="0.6" />
                    </StackPanel>

                    <Image Source="{Binding PreviewImage}"
                           Stretch="Uniform"
                           Margin="10"
                           IsVisible="{Binding HasImage}" />
                </Grid>
            </Border>

            <!-- 右侧：检测结果列表 -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0"
                               Text="检测结果"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,10" />

                    <ScrollViewer Grid.Row="1"
                                  IsVisible="{Binding HasResults}">
                        <ItemsControl ItemsSource="{Binding DetectionResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DetectionResult">
                                    <Border Background="{DynamicResource SukiBackground}"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,4">
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ConfidenceText}"
                                                           Foreground="{DynamicResource SukiAccent}"
                                                           FontSize="12" />
                                            </Grid>
                                            <TextBlock Text="{Binding BoundsText}"
                                                       Opacity="0.5"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1"
                               Text="暂无检测结果"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.3"
                               IsVisible="{Binding !HasResults}" />
                </Grid>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3"
                Background="{DynamicResource SukiCardBackground}"
                CornerRadius="8"
                Padding="16"
                Margin="20,0,20,20">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <SelectableTextBlock Grid.Column="0"
                                     Text="{Binding StatusMessage}"
                                     Opacity="0.8" />
                <SelectableTextBlock Grid.Column="1"
                                     Text="{Binding CaptureDurationText}"
                                     Opacity="0.7"
                                     Margin="0,0,16,0" />
                <SelectableTextBlock Grid.Column="2"
                                     Text="{Binding DetectionDurationText}"
                                     Foreground="{DynamicResource SukiAccent}"
                                     FontWeight="SemiBold" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
