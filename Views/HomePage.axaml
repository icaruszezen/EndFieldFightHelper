<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:EndFieldFightHelper.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="EndFieldFightHelper.Views.HomePage"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30" Spacing="16">

            <TextBlock Text="战斗辅助" FontSize="28" FontWeight="Bold" />

            <!-- 总开关卡片 -->
            <Border Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    Padding="24,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="战斗辅助总开关" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="开启后将对游戏进行截图与识别，子功能开关才会生效"
                                   Opacity="0.6" FontSize="12" Margin="0,4,0,0" />
                        <TextBlock Text="提示：请先启动游戏，点击运行将自动搜索 Endfield 窗口"
                                   FontSize="11" Foreground="#FF9800" Margin="0,4,0,0"
                                   IsVisible="{Binding !IsWindowBound}" />
                    </StackPanel>
                    <Panel Grid.Column="1">
                        <Button Command="{Binding ToggleBattleAssistCommand}"
                                Background="#3322C55E"
                                IsVisible="{Binding !IsBattleAssistEnabled}"
                                VerticalAlignment="Center"
                                Padding="16,8"
                                FontSize="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                                          Width="14" Height="14"
                                          Foreground="#22C55E" />
                                <TextBlock Text="运行" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleBattleAssistCommand}"
                                Background="#33EF4444"
                                IsVisible="{Binding IsBattleAssistEnabled}"
                                VerticalAlignment="Center"
                                Padding="16,8"
                                FontSize="14">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="M18,18H6V6H18V18Z"
                                          Width="14" Height="14"
                                          Foreground="#EF4444" />
                                <TextBlock Text="停止" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Panel>
                </Grid>
            </Border>

            <!-- 中间两列区域 -->
            <Grid ColumnDefinitions="320,16,*">

                <!-- 左列：窗口预览卡片 -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SukiCardBackground}"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Endfield 窗口绑定" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="自动绑定 Endfield 游戏进程窗口"
                                       Opacity="0.6" FontSize="11" />
                        </StackPanel>

                        <!-- 窗口绑定状态 -->
                        <Border Background="{DynamicResource SukiBackground}"
                                CornerRadius="4"
                                Padding="10,8">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Panel Grid.Column="0"
                                           Width="8" Height="8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#22C55E"
                                                 IsVisible="{Binding IsWindowBound}" />
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#EF4444"
                                                 IsVisible="{Binding !IsWindowBound}" />
                                    </Panel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding WindowStatusText}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Content="刷新"
                                            Command="{Binding RefreshWindowCommand}"
                                            Padding="8,4"
                                            FontSize="11" />
                                </Grid>
                                <TextBlock Text="请启动 Endfield 后点击刷新按钮"
                                           FontSize="11"
                                           Foreground="#EF4444"
                                           IsVisible="{Binding !IsWindowBound}" />
                            </StackPanel>
                        </Border>

                        <!-- 截图预览区域 -->
                        <Border Background="{DynamicResource SukiBackground}"
                                CornerRadius="4"
                                Height="180"
                                ClipToBounds="True">
                            <Panel>
                                <TextBlock Text="截图预览"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.3"
                                           IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNull}}" />
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       IsVisible="{Binding PreviewImage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </Border>

                        <!-- 预览控制按钮 -->
                        <Button Command="{Binding TogglePreviewCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="0,8"
                                IsEnabled="{Binding IsWindowBound}">
                            <Button.Content>
                                <Panel>
                                    <TextBlock Text="开始预览"
                                               IsVisible="{Binding !IsPreviewRunning}" />
                                    <TextBlock Text="停止预览"
                                               IsVisible="{Binding IsPreviewRunning}" />
                                </Panel>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 右列：功能开关卡片 -->
                <Border Grid.Column="2"
                        Background="{DynamicResource SukiCardBackground}"
                        CornerRadius="8"
                        Padding="24,20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="功能开关" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="各辅助功能的独立开关，需先开启总开关"
                                   Opacity="0.6" FontSize="12" Margin="0,-6,0,0" />

                        <StackPanel Spacing="6"
                                    Margin="0,4,0,0">

                            <!-- 自动闪避 -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="自动闪避" FontWeight="SemiBold" />
                                    <TextBlock Text="检测到敌方攻击时自动执行闪避操作"
                                               Opacity="0.6" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding OpenDodgeSettingsCommand}"
                                        VerticalAlignment="Center"
                                        Padding="6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip.Tip="闪避设置">
                                    <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                              Width="16" Height="16"
                                              Opacity="0.6" />
                                </Button>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding IsAutoDodgeEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Separator Opacity="0.2" />

                            <!-- 自动战技 -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="自动战技" FontWeight="SemiBold" />
                                    <TextBlock Text="技力充能完成时按配队顺序自动释放战技"
                                               Opacity="0.6" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding OpenAutoSkillOrderSettingsCommand}"
                                        VerticalAlignment="Center"
                                        Padding="6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip.Tip="战技循环顺序设置">
                                    <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                              Width="16" Height="16"
                                              Opacity="0.6" />
                                </Button>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding IsAutoSkillEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Separator Opacity="0.2" />

                            <!-- 自动攻击 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="自动攻击" FontWeight="SemiBold" />
                                    <TextBlock Text="自动执行普通攻击连段"
                                               Opacity="0.6" FontSize="11" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding IsAutoAttackEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Separator Opacity="0.2" />

                            <!-- 自动终结技 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="自动终结技" FontWeight="SemiBold" />
                                    <TextBlock Text="终结技可用时自动释放"
                                               Opacity="0.6" FontSize="11" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding IsAutoUltimateEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Separator Opacity="0.2" />

                            <!-- 自动连携技 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="自动连携技" FontWeight="SemiBold" />
                                    <TextBlock Text="检测到连携触发时自动按下E键"
                                               Opacity="0.6" FontSize="11" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding IsAutoChainSkillEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Separator Opacity="0.2" />

                            <!-- 自动打轴 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="自动打轴" FontWeight="SemiBold" />
                                    <TextBlock Text="按导入的战斗轴自动执行战斗操作（需先导入轴数据）"
                                               Opacity="0.6" FontSize="11" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1"
                                              IsChecked="{Binding IsAutoAxisEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>

                            <Separator Opacity="0.2" />

                            <!-- 叠加层 -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="战斗叠加层" FontWeight="SemiBold" />
                                    <TextBlock Text="在游戏窗口左侧显示战斗信息叠加层"
                                               Opacity="0.6" FontSize="11" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding OpenOverlayContentSettingsCommand}"
                                        VerticalAlignment="Center"
                                        Padding="6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip.Tip="叠加层显示设置">
                                    <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                              Width="16" Height="16"
                                              Opacity="0.6" />
                                </Button>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding IsBattleOverlayEnabled}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 日志卡片 -->
            <Border Background="{DynamicResource SukiCardBackground}"
                    CornerRadius="8"
                    Padding="20">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                        <TextBlock Grid.Column="0"
                                   Text="运行日志"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="清空"
                                Command="{Binding ClearLogCommand}"
                                Padding="10,4"
                                FontSize="11" />
                    </Grid>

                    <Border Background="{DynamicResource SukiBackground}"
                            CornerRadius="4"
                            Padding="8"
                            Height="180">
                        <ScrollViewer x:Name="LogScrollViewer"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding LogMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}"
                                                   FontSize="12"
                                                   FontFamily="Consolas, Courier New, monospace"
                                                   Opacity="0.85"
                                                   Padding="2,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
