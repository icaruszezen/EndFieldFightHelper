<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EndFieldFightHelper.ViewModels"
        mc:Ignorable="d"
        x:Class="EndFieldFightHelper.Views.OverlayWindow"
        x:DataType="vm:OverlayViewModel"
        Width="300"
        Height="120"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SystemDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        CanResize="False"
        WindowStartupLocation="Manual">
    <Grid>
        <!-- Background layer (opacity-controlled) -->
        <Border Background="Black"
                CornerRadius="6"
                Margin="6"
                Opacity="{Binding BackgroundOpacity}" />

        <!-- Content layer (always fully visible) -->
        <Border x:Name="ContentBorder"
                CornerRadius="6"
                Padding="8"
                Margin="6">
            <ScrollViewer x:Name="LogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding LogMessages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       Foreground="White"
                                       FontSize="11"
                                       FontFamily="Consolas, Courier New, monospace"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       Padding="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Edit-mode highlight border -->
        <Border x:Name="EditBorder"
                BorderBrush="#CCFFCC00"
                BorderThickness="2"
                CornerRadius="6"
                Margin="4"
                IsVisible="{Binding IsEditMode}"
                IsHitTestVisible="False" />

        <!-- Resize grips (only visible in edit mode) -->
        <Canvas x:Name="ResizeCanvas" IsVisible="{Binding IsEditMode}">
            <!-- Right edge -->
            <Border x:Name="GripRight" Width="8" Background="Transparent"
                    Cursor="SizeWestEast" />
            <!-- Bottom edge -->
            <Border x:Name="GripBottom" Height="8" Background="Transparent"
                    Cursor="SizeNorthSouth" />
            <!-- Bottom-right corner -->
            <Border x:Name="GripBottomRight" Width="12" Height="12"
                    Background="#88FFCC00" CornerRadius="2"
                    Cursor="BottomRightCorner" />
        </Canvas>

        <!-- Toggle edit-mode button (top-right) -->
        <Button x:Name="EditToggleButton"
                Command="{Binding ToggleEditModeCommand}"
                Width="24" Height="24"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,0,0,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Opacity="0.5"
                ToolTip.Tip="切换编辑模式">
            <Panel>
                <!-- Unlocked icon (normal mode) -->
                <PathIcon Data="M18,8H17V6A5,5 0 0,0 12,1A5,5 0 0,0 7,6H9A3,3 0 0,1 12,3A3,3 0 0,1 15,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M18,20H6V10H18V20M12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17Z"
                          Width="14" Height="14"
                          Foreground="White"
                          IsVisible="{Binding !IsEditMode}" />
                <!-- Locked/editing icon (edit mode) -->
                <PathIcon Data="M12,17A2,2 0 0,0 14,15C14,13.89 13.1,13 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10C4,8.89 4.9,8 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                          Width="14" Height="14"
                          Foreground="#FFCC00"
                          IsVisible="{Binding IsEditMode}" />
            </Panel>
        </Button>
    </Grid>
</Window>
