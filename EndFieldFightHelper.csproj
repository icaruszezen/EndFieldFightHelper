<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.0</Version>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <!-- Used by: YoloDetectionService.cs, DxgiDesktopDuplicationCapture.cs, WindowsGraphicsCaptureCapture.cs -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.11" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageReference Include="SukiUI" Version="6.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.2" />
    <PackageReference Include="YoloSharp.Core" Version="6.1.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.2" />
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Resources\public\**" />
    <None Remove="Resources\public\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == '' ">
    <None Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll"
          Link="libs\DirectML.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PlaceDllsInLibsFolder" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Update="@(ReferenceCopyLocalPaths)"
        Condition="'%(Extension)' == '.dll'"
        DestinationSubDirectory="libs\" />
    </ItemGroup>
  </Target>

  <Target Name="MoveRemainingDllsToLibs" AfterTargets="Build">
    <ItemGroup>
      <_RootDlls Include="$(TargetDir)*.dll;$(TargetDir)*.lib" Exclude="$(TargetDir)$(AssemblyName).dll" />
    </ItemGroup>
    <Move SourceFiles="@(_RootDlls)" DestinationFolder="$(TargetDir)libs\" />
    <RemoveDir Directories="$(TargetDir)runtimes" Condition="Exists('$(TargetDir)runtimes')" />
  </Target>

  <Target Name="MovePublishDllsToLibs" AfterTargets="Publish">
    <ItemGroup>
      <_PublishRootDlls Include="$(PublishDir)*.dll;$(PublishDir)*.lib" Exclude="$(PublishDir)$(AssemblyName).dll" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)libs" />
    <Move SourceFiles="@(_PublishRootDlls)" DestinationFolder="$(PublishDir)libs\" />
    <RemoveDir Directories="$(PublishDir)runtimes" Condition="Exists('$(PublishDir)runtimes')" />
  </Target>
</Project>
