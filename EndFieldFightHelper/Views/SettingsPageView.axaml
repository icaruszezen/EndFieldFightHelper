<UserControl x:Class="EndFieldFightHelper.Views.SettingsPageView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:suki="https://github.com/kikipoulet/SukiUI"
             xmlns:vm="using:EndFieldFightHelper.ViewModels"
             d:DesignHeight="560"
             d:DesignWidth="900"
             x:DataType="vm:SettingsPageViewModel"
             mc:Ignorable="d">
    <ScrollViewer Padding="24"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch"
                    Spacing="20">
            <Border HorizontalAlignment="Stretch"
                    Padding="20"
                    Background="{DynamicResource SukiCardBackground}"
                    BorderBrush="{DynamicResource SukiBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="28"
                               FontWeight="Bold"
                               Text="设置" />
                    <TextBlock Foreground="{DynamicResource SukiLowText}"
                               Text="仅保留亮色模式，可切换界面主色。" />
                </StackPanel>
            </Border>

            <suki:GlassCard HorizontalAlignment="Stretch"
                            Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="16"
                                   FontWeight="DemiBold"
                                   Text="颜色主题" />
                        <TextBlock Foreground="{DynamicResource SukiLowText}"
                                   Text="选择一个主色调应用到整个界面" />
                    </StackPanel>

                    <Border Padding="12"
                            Background="{DynamicResource SukiCardBackground}"
                            BorderBrush="{DynamicResource SukiBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <ItemsControl ItemsSource="{Binding ColorThemes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"
                                               ItemWidth="74"
                                               ItemHeight="86" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Spacing="6">
                                        <Button Width="50"
                                                Height="50"
                                                Padding="0"
                                                Command="{Binding $parent[UserControl].((vm:SettingsPageViewModel)DataContext).ChangeColorThemeCommand}"
                                                CommandParameter="{Binding}"
                                                CornerRadius="25"
                                                ToolTip.Tip="{Binding DisplayName}">
                                            <Border Width="50"
                                                    Height="50"
                                                    Background="{Binding PrimaryBrush}"
                                                    BorderBrush="{DynamicResource SukiBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="25" />
                                        </Button>
                                        <TextBlock Width="68"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SukiLowText}"
                                                   FontSize="11"
                                                   Text="{Binding DisplayName}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </suki:GlassCard>
        </StackPanel>
    </ScrollViewer>
</UserControl>
